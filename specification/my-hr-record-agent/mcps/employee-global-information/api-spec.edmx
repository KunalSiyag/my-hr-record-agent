<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="SFODataSet" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.sap.com/Protocols/SAPData">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="PerGlobalInfoUSA" EntityType="SFOData.PerGlobalInfoUSA" sap:label="Global Information USA" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
                <EntitySet Name="PerGlobalInfoGBR" EntityType="SFOData.PerGlobalInfoGBR" sap:label="Global Information GBR" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
                <EntitySet Name="PerGlobalInfoDEU" EntityType="SFOData.PerGlobalInfoDEU" sap:label="Global Information DEU" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
            </EntityContainer>
        </Schema>
        <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.successfactors.com/edm/sap">
            <EntityType Name="PerGlobalInfoUSA">
                <Key><PropertyRef Name="personIdExternal"/><PropertyRef Name="country"/><PropertyRef Name="startDate"/></Key>
                <Property Name="personIdExternal" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="Person ID External"/>
                <Property Name="country" Type="Edm.String" Nullable="false" sap:label="Country"/>
                <Property Name="startDate" Type="Edm.DateTime" Nullable="false" sap:display-format="Date" sap:label="Start Date"/>
                <Property Name="endDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="End Date"/>
            </EntityType>
            <EntityType Name="PerGlobalInfoGBR">
                <Key><PropertyRef Name="personIdExternal"/><PropertyRef Name="country"/><PropertyRef Name="startDate"/></Key>
                <Property Name="personIdExternal" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="Person ID External"/>
                <Property Name="country" Type="Edm.String" Nullable="false" sap:label="Country"/>
                <Property Name="startDate" Type="Edm.DateTime" Nullable="false" sap:display-format="Date" sap:label="Start Date"/>
                <Property Name="endDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="End Date"/>
            </EntityType>
            <EntityType Name="PerGlobalInfoDEU">
                <Key><PropertyRef Name="personIdExternal"/><PropertyRef Name="country"/><PropertyRef Name="startDate"/></Key>
                <Property Name="personIdExternal" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="Person ID External"/>
                <Property Name="country" Type="Edm.String" Nullable="false" sap:label="Country"/>
                <Property Name="startDate" Type="Edm.DateTime" Nullable="false" sap:display-format="Date" sap:label="Start Date"/>
                <Property Name="endDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="End Date"/>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
