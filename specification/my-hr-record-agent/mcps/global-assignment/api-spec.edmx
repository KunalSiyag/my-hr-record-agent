<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="SFODataSet" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.sap.com/Protocols/SAPData">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="EmpGlobalAssignment" EntityType="SFOData.EmpGlobalAssignment" sap:label="Global Assignment Details" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
            </EntityContainer>
        </Schema>
        <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.successfactors.com/edm/sap">
            <EntityType Name="EmpGlobalAssignment">
                <Key><PropertyRef Name="userId"/></Key>
                <Property Name="userId" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="User ID"/>
                <Property Name="personIdExternal" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="Person ID External"/>
                <Property Name="assignmentType" Type="Edm.String" Nullable="true" sap:label="Assignment Type"/>
                <Property Name="startDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="Start Date"/>
                <Property Name="plannedEndDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="Planned End Date"/>
                <Property Name="endDate" Type="Edm.DateTime" Nullable="true" sap:display-format="Date" sap:label="Actual End Date"/>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
