<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="SFODataSet" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.sap.com/Protocols/SAPData">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="EmpEmployment" EntityType="SFOData.EmpEmployment" sap:label="Employment Details" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
                <EntitySet Name="EmpJob" EntityType="SFOData.EmpJob" sap:label="Job Information" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
                <EntitySet Name="EmpJobRelationships" EntityType="SFOData.EmpJobRelationships" sap:label="Job Relationships" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
                <EntitySet Name="EmpWorkPermit" EntityType="SFOData.EmpWorkPermit" sap:label="Work Permit Info" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"/>
            </EntityContainer>
        </Schema>
        <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <EntityType Name="EmpEmployment"><Key><PropertyRef Name="personIdExternal"/><PropertyRef Name="userId"/></Key><Property Name="personIdExternal" Type="Edm.String" Nullable="false"/><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="startDate" Type="Edm.DateTime" Nullable="true"/></EntityType>
            <EntityType Name="EmpJob"><Key><PropertyRef Name="userId"/><PropertyRef Name="seqNumber"/><PropertyRef Name="startDate"/></Key><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="seqNumber" Type="Edm.Int64" Nullable="false"/><Property Name="startDate" Type="Edm.DateTime" Nullable="false"/><Property Name="jobTitle" Type="Edm.String" Nullable="true"/><Property Name="department" Type="Edm.String" Nullable="true"/><Property Name="company" Type="Edm.String" Nullable="true"/><Property Name="emplStatus" Type="Edm.String" Nullable="true"/><Property Name="employmentType" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="EmpJobRelationships"><Key><PropertyRef Name="userId"/><PropertyRef Name="relationshipType"/><PropertyRef Name="startDate"/></Key><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="relationshipType" Type="Edm.String" Nullable="false"/><Property Name="startDate" Type="Edm.DateTime" Nullable="false"/><Property Name="relUserId" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="EmpWorkPermit"><Key><PropertyRef Name="userId"/><PropertyRef Name="country"/><PropertyRef Name="documentNumber"/><PropertyRef Name="documentType"/></Key><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="country" Type="Edm.String" Nullable="false"/><Property Name="documentNumber" Type="Edm.String" Nullable="false"/><Property Name="documentType" Type="Edm.String" Nullable="false"/></EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
