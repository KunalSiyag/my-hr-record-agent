# Copy to .env next to README.md and fill values: cp .env.example .env
# .env is gitignored (see .gitignore) — never commit real secrets.

# --- Local test mode ---
IBD_TESTING=1

# --- SAP AI Core (from README.md Local Run) ---
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=

# --- Agent server (app/main.py) ---
HOST=0.0.0.0
PORT=5000
AGENT_PUBLIC_URL=http://localhost:5000/

# --- Basic mail: Brevo HTTP API preferred (port 443, works on corp network) ---
# Get from Brevo dashboard: SMTP & API > API Keys (xkeysib-...).
# Sender must be a verified sender in Brevo.
BREVO_API_KEY=
# --- Basic mail fallback: SMTP (blocked on some corp networks, usually works deployed) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# --- MCP tuning (app/util.py, optional) ---
MCP_CALL_TIMEOUT_SECONDS=30.0
MCP_MAX_RESPONSE_CHARS=30000
