<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="SFODataSet" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.sap.com/Protocols/SAPData">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="EPPublicProfile" EntityType="SFOData.EPPublicProfile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
                <EntitySet Name="Background_Education" EntityType="SFOData.Background_Education" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
                <EntitySet Name="Background_Languages" EntityType="SFOData.Background_Languages" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
            </EntityContainer>
        </Schema>
        <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <EntityType Name="EPPublicProfile"><Key><PropertyRef Name="userId"/></Key><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="introduction" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="Background_Education"><Key><PropertyRef Name="backgroundElementId"/><PropertyRef Name="userId"/></Key><Property Name="backgroundElementId" Type="Edm.Int64" Nullable="false"/><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="school" Type="Edm.String" Nullable="true"/><Property Name="degree" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="Background_Languages"><Key><PropertyRef Name="backgroundElementId"/><PropertyRef Name="userId"/></Key><Property Name="backgroundElementId" Type="Edm.Int64" Nullable="false"/><Property Name="userId" Type="Edm.String" Nullable="false"/><Property Name="language" Type="Edm.String" Nullable="true"/></EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
