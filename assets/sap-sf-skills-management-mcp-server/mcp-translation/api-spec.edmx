<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="SFODataSet" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sap="http://www.sap.com/Protocols/SAPData">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="SkillProfile" EntityType="SFOData.SkillProfile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
                <EntitySet Name="SkillEntity" EntityType="SFOData.SkillEntity" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
                <EntitySet Name="CompetencyEntity" EntityType="SFOData.CompetencyEntity" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
                <EntitySet Name="RatedSkillMapping" EntityType="SFOData.RatedSkillMapping" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"/>
            </EntityContainer>
        </Schema>
        <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <EntityType Name="SkillProfile"><Key><PropertyRef Name="externalCode"/></Key><Property Name="externalCode" Type="Edm.String" Nullable="false"/><Property Name="status" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="SkillEntity"><Key><PropertyRef Name="externalCode"/></Key><Property Name="externalCode" Type="Edm.String" Nullable="false"/><Property Name="name_defaultValue" Type="Edm.String" Nullable="true"/><Property Name="status" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="CompetencyEntity"><Key><PropertyRef Name="externalCode"/></Key><Property Name="externalCode" Type="Edm.String" Nullable="false"/><Property Name="name_defaultValue" Type="Edm.String" Nullable="true"/><Property Name="status" Type="Edm.String" Nullable="true"/></EntityType>
            <EntityType Name="RatedSkillMapping"><Key><PropertyRef Name="SkillProfile_externalCode"/><PropertyRef Name="externalCode"/></Key><Property Name="SkillProfile_externalCode" Type="Edm.String" Nullable="false"/><Property Name="externalCode" Type="Edm.String" Nullable="false"/><Property Name="skill" Type="Edm.String" Nullable="true"/></EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
